<Window x:Class="Homework1._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Homework1._1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Viewbox Stretch="Uniform" Width="500" Height="300">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100" Height="30" Text="Имя"/>
                    <TextBox Name="FirstName" Height="30" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100" Height="30" Text="Фамилия"/>
                    <TextBox Name="SecondName" Height="30" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="100" Height="30" Text="Отчество"/>
                    <TextBox Name="ThirdName" Height="30" Width="150"/>
                </StackPanel>
                <Button Width="250" Height="30" Content="Сохранить данные" Click="Button_Save_Data"/>
                <CheckBox Name="add" Content="Согласен на рассылку рекламы" IsChecked="True"/>
                <CheckBox Name="adwd" Content="Согласен на обработку перс данных"/>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
